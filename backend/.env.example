# KLM AI Clinic Assistant — Backend Environment Variables Example

# App
APP_NAME="KLM AI Clinic Assistant"
APP_VERSION="1.0.0"
DEBUG=False
SECRET_KEY="replace-with-a-random-secret-key-for-production"

# Groq LLM
GROQ_API_KEY="gsk_..."
GROQ_MODEL="llama-3.3-70b-versatile"

# Supabase
# The deployed project host kxliehrgflqkhnejbykr.supabase.co does not resolve DNS;
# use a restored/active project URL instead. See README for full troubleshooting.
SUPABASE_URL="https://mxvxwqlhsypjehcdrgqp.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_uNRYASZ_rS0i-fXKxK4bcg_094dXUmG"
# SUPABASE_SERVICE_ROLE_KEY must be fetched from the Supabase Dashboard → Settings → API
# (API Keys section). The Python supabase-py client (>= 2.34.1) now supports the new
# sb_publishable_ and sb_secret_ key formats used by active projects.
# With supabase-py 2.34.1+, the service-role key can be the new format:
#   SUPABASE_SERVICE_ROLE_KEY="sb_secret_INSERT_YOUR_SERVICE_ROLE_KEY_HERE"
# If stuck on supabase-py 2.10.x, use the plain dashboard key instead.
# Optional: legacy project JWT secret. Only used as a local verification
# fallback when Supabase Auth is briefly unreachable. Never expose to frontend.
SUPABASE_JWT_SECRET="your-jwt-secret"
# Supabase Python client version requirement: supabase>=2.34.1
# (earlier versions reject the sb_publishable_ / sb_secret_ key prefixes).

# Public demo account (credentials are intentionally public)
# The backend advertises these on /api/v1/auth/demo-config and the login page.
# The account is read-only and receives isolated sample data — no real records.
DEMO_MODE_ENABLED=true
DEMO_USER_EMAIL="demo@gmail.com"
DEMO_USER_PASSWORD="demo123"
DEMO_USER_NAME="Demo Receptionist"
DEMO_USER_PHONE="+1-555-0100"

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="your-token"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Google OAuth2 (Gmail API)
# Use OAuth 2.0 Playground or other tools to get the refresh token
GOOGLE_CLIENT_ID="...apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."
GOOGLE_REFRESH_TOKEN="1//0..."

# Clinic Information
CLINIC_NAME="KLM AI Clinic"
CLINIC_ADDRESS="123 Health Street, Medical District, NY 10001"
CLINIC_PHONE="+911234567890"
CLINIC_EMAIL="your-clinic@gmail.com"
CLINIC_HOURS="Monday-Friday: 8AM-6PM, Saturday: 9AM-2PM"

# Inbox Polling
IMAP_SERVER="imap.gmail.com"
IMAP_PORT=993
IMAP_EMAIL="your-clinic@gmail.com"
IMAP_PASSWORD="your-google-app-password"

# Safety
CONFIDENCE_THRESHOLD=0.6
