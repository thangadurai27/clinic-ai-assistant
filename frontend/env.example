# Backend API base (include /api/v1).
# If omitted, production builds default to the deployed Render backend and
# local development defaults to http://localhost:8001/api/v1.
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1

# Optional: override the realtime WebSocket URL. When omitted it is derived
# from NEXT_PUBLIC_API_URL (http -> ws, https -> wss) with a /ws suffix.
# NEXT_PUBLIC_WS_URL=ws://localhost:8001/api/v1/ws

# Supabase Realtime (public values). Realtime is optional; the dashboard still
# works via normal query refetching if these are missing or unreachable.
# The project kxliehrgflqkhnejbykr no longer resolves; use the new project URL.
NEXT_PUBLIC_SUPABASE_URL=https://mxvxwqlhsypjehcdrgqp.supabase.co
